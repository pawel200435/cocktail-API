generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CocktailCategory {
  SHOT
  LONG_DRINK

  @@map("cocktail_category")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coctails Cocktail[]

  @@map("users")
}

model Ingredient {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  description String         @db.Text
  isAlcohol   Boolean        @map("is_alcohol")
  imageUrl    String         @map("image_url") @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  cocktails   CocktailItem[]

  @@map("ingredients")
}

model Cocktail {
  id           Int              @id @default(autoincrement())
  name         String           @db.VarChar(100)
  category     CocktailCategory
  instructions String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  ingredients  CocktailItem[]
  userId       Int              @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cocktails")
}

model CocktailItem {
  cocktailId   Int        @map("cocktail_id")
  ingredientId Int        @map("ingredient_id")
  amount       Decimal    @db.Decimal(10, 2)
  unit         String     @db.VarChar(20)
  cocktail     Cocktail   @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([cocktailId, ingredientId]) // Composite primary key
  @@map("cocktail_items")
}
